# Environment Configuration
# Copy this file to .env and fill in your actual values

# Microsoft Foundry Project Endpoint
# Get this from the Foundry project
# In VSC, you can try Foundry Toolkit > right-click your active project > Copy Endpoint
# If that option isn't available, copy the endpoint from the Microsoft Foundry portal project overview page
PROJECT_ENDPOINT=https://it-support-agent-pr-resource.services.ai.azure.com/api/projects/it-support-agent-project

# Agent name (created in the portal)
AGENT_NAME=it-support-agent
